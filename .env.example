NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (database/ 패키지와 서버가 함께 사용)
# For standalone EC2 Docker Compose, these are REQUIRED; copy the generated private .env instead.
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
DB_AI_PASSWORD=replace-with-a-strong-ai-db-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leren

# 서버 실행·테스트용 (읽기·쓰기만)
DB_USER=app_user
DB_PASSWORD=replace-with-a-strong-app-db-password

# 마이그레이션 전용 (스키마 변경)
DB_MIGRATION_USER=migrator
DB_MIGRATION_PASSWORD=replace-with-a-strong-migration-db-password

# RDS 접속 시 true + RDS CA 인증서 내용
DB_SSL=false
DB_SSL_CA=

# API / Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# FastAPI internal service
FASTAPI_BASE_URL=http://127.0.0.1:8000
FASTAPI_INTERNAL_TOKEN=replace-with-fastapi-internal-token
FASTAPI_TIMEOUT_MS=5000
AI_DAILY_LIMIT=20

# 카카오 OAuth REST API 키 및 활성화된 Client Secret (필수)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 쉼표로 구분한 HTTP(S) Redirect URI 허용 목록. 인가 요청 URI와 정확히 일치해야 함
# 미설정 시 카카오 로그인만 실패하며, 실제 URI는 프론트엔드 협의 후 설정
KAKAO_ALLOWED_REDIRECT_URIS=

# 백엔드 콜백 주소: 위 허용 목록과 정확히 일치, 경로 /api/v1/auth/kakao/callback
KAKAO_OAUTH_CALLBACK_URL=
# 서버가 선택한 앱 복귀 주소(leren 스킴 또는 HTTPS). 쿼리/fragment 없이 프론트와 확정
KAKAO_APP_DEEP_LINK=
# 웹 복귀 주소. /auth/callback 경로로 정확히 설정. 운영은 HTTPS, 개발/테스트 loopback HTTP 허용.
# 이 주소의 origin에서 카카오 로그인 시작/교환 요청만 CORS 허용. 비워 두면 웹 로그인이 비활성화된다.
# 운영 예시(PC 웹 개발용): http://localhost:3001/auth/callback (아래 플래그를 true로 함께 설정)
KAKAO_WEB_RETURN_URL=
# 운영(NODE_ENV=production)에서 http://localhost:<포트>/auth/callback 웹 복귀를 허용할지 (true/false, 기본 false)
# 127.0.0.1, 포트 없는 주소, 다른 경로는 허용하지 않는다. 공개 웹 배포 후에는 HTTPS 주소로 바꾸고 false로 끈다.
KAKAO_ALLOW_LOOPBACK_WEB_RETURN=
# 서버가 허용한 앱 복귀 주소의 쉼표 구분 목록
KAKAO_ALLOWED_APP_DEEP_LINKS=
# 개발/테스트: memory 또는 postgres. 운영: postgres 및 OAuth 테이블 마이그레이션 필수.
KAKAO_OAUTH_STORE_MODE=
# state 최대 600초, exchange 최대 120초. 기본값 각각 300/60
KAKAO_OAUTH_STATE_TTL_SECONDS=
KAKAO_OAUTH_EXCHANGE_TTL_SECONDS=
# 기존 직접 로그인 API: 개발/테스트만 true로 허용 가능. 운영은 항상 차단
KAKAO_LEGACY_DIRECT_LOGIN_ENABLED=

# 비밀번호 재설정 메일. 승인된 SMTP 릴레이·발신 주소·프론트 HTTPS 주소를 지정합니다.
# 비워 두면 재설정 요청만 503을 반환합니다. 자격증명은 보안 환경변수로 주입합니다.
PASSWORD_RESET_SMTP_HOST=
PASSWORD_RESET_SMTP_PORT=587
PASSWORD_RESET_SMTP_USER=
PASSWORD_RESET_SMTP_PASS=
PASSWORD_RESET_FROM=
PASSWORD_RESET_URL=

# Question generation is opt-in. Keep false until live AI calls/costs are approved.
QUESTION_GENERATION_ENABLED=false
# Server-owned canonical approved EvidenceSource JSONL; never supplied by API callers.
QUESTION_GENERATION_EVIDENCE_PATH=
# Generation may take longer than tutoring; no automatic retry.
QUESTION_GENERATION_TIMEOUT_MS=120000

# 학습 알림(푸시) 스케줄러: true일 때만 1분마다 설정 시각이 된 사용자에게 발송. Android 연동(E-3) 전까지 false
PUSH_SCHEDULER_ENABLED=false
# Expo Access Token (선택): Expo 계정의 푸시 보안 설정을 켠 경우에만 필요. 운영은 Parameter Store
EXPO_ACCESS_TOKEN=
# Expo 푸시 요청 제한 시간(ms), 기본 10000
EXPO_PUSH_TIMEOUT_MS=
