NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (database/ 패키지와 서버가 함께 사용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leren

# 서버 실행·테스트용 (읽기·쓰기만)
DB_USER=app_user
DB_PASSWORD=app_local

# 마이그레이션 전용 (스키마 변경)
DB_MIGRATION_USER=migrator
DB_MIGRATION_PASSWORD=migrator_local

# RDS 접속 시 true + RDS CA 인증서 내용
DB_SSL=false
DB_SSL_CA=
