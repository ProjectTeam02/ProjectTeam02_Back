NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (database/ 패키지와 서버가 함께 사용)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leren

# 서버 실행·테스트용 (읽기·쓰기만)
DB_USER=app_user
DB_PASSWORD=app_local

# 마이그레이션 전용 (스키마 변경)
DB_MIGRATION_USER=migrator
DB_MIGRATION_PASSWORD=migrator_local

# RDS 접속 시 true + RDS CA 인증서 내용
DB_SSL=false
DB_SSL_CA=

# API / Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# FastAPI internal service
FASTAPI_BASE_URL=http://127.0.0.1:8000
FASTAPI_INTERNAL_TOKEN=replace-with-fastapi-internal-token
FASTAPI_TIMEOUT_MS=5000
AI_DAILY_LIMIT=20

# 카카오 OAuth REST API 키 및 활성화된 Client Secret (필수)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 쉼표로 구분한 HTTP(S) Redirect URI 허용 목록. 인가 요청 URI와 정확히 일치해야 함
# 미설정 시 카카오 로그인만 실패하며, 실제 URI는 프론트엔드 협의 후 설정
KAKAO_ALLOWED_REDIRECT_URIS=

# 백엔드 콜백 주소: 위 허용 목록과 정확히 일치, 경로 /api/v1/auth/kakao/callback
KAKAO_OAUTH_CALLBACK_URL=
# 서버가 선택한 앱 복귀 주소(leren 스킴 또는 HTTPS). 쿼리/fragment 없이 프론트와 확정
KAKAO_APP_DEEP_LINK=
# 서버가 허용한 앱 복귀 주소의 쉼표 구분 목록
KAKAO_ALLOWED_APP_DEEP_LINKS=
# 개발/테스트 단일 프로세스만 memory를 명시적으로 사용 가능. 운영은 공유 저장소 구현 전 차단
KAKAO_OAUTH_STORE_MODE=
# state 최대 600초, exchange 최대 120초. 기본값 각각 300/60
KAKAO_OAUTH_STATE_TTL_SECONDS=
KAKAO_OAUTH_EXCHANGE_TTL_SECONDS=
# 기존 직접 로그인 API: 개발/테스트만 true로 허용 가능. 운영은 항상 차단
KAKAO_LEGACY_DIRECT_LOGIN_ENABLED=
