  character_classes
  costumes
  user_characters
  user_costumes
  user_equipped_costumes
}
TableGroup content [color: #2E8B57] {
  topics
  topic_prerequisites
  stages
  concepts
  concept_prerequisites
  concept_sections
  stage_concepts
  questions
  question_choices
  stage_questions
}
TableGroup progress_quiz [color: #C0702A] {
  user_stage_progress
  learning_attempts
  question_submissions
}
TableGroup reward [color: #B8932B] {
  user_growth
  user_wallets
  exp_ledger
  coin_ledger
  level_thresholds
}
TableGroup review_plan [color: #B5475B] {
  review_items
  review_missions
  review_attempts
  review_submissions
  study_plans
}
TableGroup ai_tutor [color: #4A4A4A] {
  ai_conversations
  ai_messages
  ai_message_sources
  ai_requests
}
