// =====================================================================
// Leren 2.0 — app 스키마 ERD v3
// 기준: leren_erd_v2 (Init 마이그레이션) + API 명세서 58개 (2026-10-24)
// rev.2 (2026-10-25): API 필드명·Enum 표기 일치 — itemId, submissionId, requestId, contentPosition, mode, Enum 대문자
// rev.3 (2026-10-25): 무결성 제약 — 진행 중 응시 1개, 보유 코스튬만 장착(복합 FK), 선택지는 해당 문항 것만(복합 FK)
// rev.4 (2026-10-25): 조회 인덱스 3개, 회원 탈퇴(users), 약관·개인정보 동의(terms, user_terms_agreements)
// rev.5 최종 (2026-10-25): 코스튬을 직업과 무관하게 상의(TOP)·하의(BOTTOM)로 분류, 부위별 장착 테이블(user_equipped_costumes)
// 변경 요약
//   1) 용어를 API 명세에 맞춤: region→topic, step→stage, job→class,
//      concept_auto_review→review_mission, review_session→review_attempt,
//      learning_schedule→study_plan, confusing(헷갈림)→bookmark
//   2) API에 필요한 데이터 추가: 개념 선수관계, 일정의 개념 연결,
//      복습 제출 중복 방지, 알림 시간대, 학습 위치 저장 시각
//   3) AI Tutor 멀티턴 RAG: 메시지별 문맥·재작성 쿼리·히스토리 범위,
//      대화 요약, clientMessageId 중복 방지, 검색 범위·청크 기록
// 규칙
//   - 모든 테이블은 app 스키마 (ai 스키마는 FastAPI가 별도 관리)
//   - PK는 uuid, 기본값 gen_random_uuid()
//   - 시각은 timestamptz, 날짜 집계는 Asia/Seoul 기준
//   - Enum 값은 대문자 SNAKE_CASE (API 명세 예시 WARRIOR/MAGE/ARCHER 기준, API와 동일 값)
//   - 컬럼명 = API 필드명의 snake_case (예: itemId → item_id, submissionId → submission_id)
//   - *_code, document_id 등 "논리 참조"는 FK 없이 저장 시 앱에서 검증
//   - DBML로 표현 못 하는 생성 컬럼·부분 인덱스는 leren_v3_schema.sql 끝에 있음
// =====================================================================

Project leren {
  database_type: 'PostgreSQL'
  Note: 'Leren 2.0 app 스키마 v3 (PostgreSQL 16). API 명세서 용어 기준.'
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------
Enum user_role {
  USER
  ADMIN
}
Enum user_plan {
  FREE
  PREMIUM
}
Enum account_status {
  ACTIVE
  SUSPENDED
  LOCKED
  WITHDRAWN [note: 'rev.4 회원 탈퇴']
}
Enum terms_type {
  SERVICE [note: '서비스 이용약관 (필수)']
  PRIVACY [note: '개인정보 수집·이용 동의 (필수)']
  AGE_OVER_14 [note: '만 14세 이상 확인 (필수)']
  MARKETING [note: '마케팅 정보 수신 동의 (선택)']
}
// login_method: TypeORM이 컬럼마다 타입을 만들어서 테이블_컬럼 이름으로 분리 (값은 동일)
Enum users_last_login_method {
  EMAIL
  KAKAO
  NAVER
  GOOGLE
  APPLE
}
Enum user_sessions_login_method {
  EMAIL
  KAKAO
  NAVER
  GOOGLE
  APPLE
}
Enum social_provider {
  KAKAO
  NAVER
  GOOGLE
  APPLE
}
Enum token_type {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
Enum device_platform {
  IOS
  ANDROID
}
Enum session_revoke_reason {
  LOGOUT
  EXPIRED
  ROTATED
  SECURITY
}

Enum class_code {
  WARRIOR
  MAGE
  ARCHER
}
Enum costume_category {
  TOP [note: '상의']
  BOTTOM [note: '하의']
}
Enum costume_acquire_type {
  DEFAULT
  PURCHASE
}

// publish_status: 테이블_컬럼 이름으로 분리 (값은 동일)
Enum topics_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}
Enum stages_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}
Enum concept_status {
  DRAFT
  REVIEW_PENDING
  PUBLISHED
  ARCHIVED
}
Enum stage_type {
  NORMAL
  BOSS
}
Enum section_type {
  INTRO
  DEFINITION
  EXAMPLE
  SUMMARY
  REMEMBER
  QUIZ_GUIDE
}
Enum card_tone {
  DEFAULT
  INFO
  EXAMPLE
  SUCCESS
}
Enum question_type {
  MULTIPLE_CHOICE
}
Enum difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}
Enum generated_by {
  AI
  MANUAL
}
Enum question_status {
  GENERATED
  AUTO_VALIDATED
  REVIEW_PENDING
  APPROVED
  REJECTED
  PUBLISHED
  RETIRED
}

Enum progress_status {
  NOT_STARTED
  IN_PROGRESS
  PASSED
}
Enum attempt_type {
  PLAY
  RELEARN [note: 'v2 replay → API의 재학습(RELEARN)']
}
Enum attempt_mode {
  START
  RETRY
}
Enum attempt_status {
  IN_PROGRESS
  PASSED
  FAILED
  ABANDONED
}
Enum attempt_end_reason {
  MONSTER_DEFEATED
  QUESTIONS_EXHAUSTED
  ABANDONED
}

Enum exp_source_type {
  STAGE_FIRST_CLEAR
}
Enum coin_transaction_type {
  EARN
  SPEND
}
Enum coin_reason {
  STAGE_FIRST_CLEAR
  COSTUME_PURCHASE
}
Enum coin_ref_type {
  STAGE
  COSTUME
}
Enum level_scope {
  ACCOUNT
  ECONOMY
}

Enum review_first_reason {
  WRONG
  BOOKMARK [note: 'v2 confusing(헷갈림) = 북마크']
}
Enum answer_result {
  CORRECT
  WRONG
}
Enum review_mission_status {
  SCHEDULED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
}
Enum review_attempt_type {
  AUTO
  RECOMMENDED
  SINGLE
}
Enum review_entry_point {
  HOME
  REVIEW_NOTE
  RESULT
  CALENDAR
}
Enum review_attempt_status {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

Enum plan_type {
  NEW_LEARNING
  REVIEW
}
Enum plan_status {
  PLANNED
  DONE
}

Enum ai_entry_point {
  NAV
  CONCEPT
  QUIZ
  RESULT
  REVIEW
}
Enum conversation_status {
  ACTIVE
  ARCHIVED
}
Enum message_role {
  USER
  ASSISTANT
}
Enum message_input_type {
  TYPED
  SUGGESTED
}
Enum message_status {
  PENDING
  COMPLETED
  FAILED
}
Enum grounding_status {
  GROUNDED
  INSUFFICIENT
}
Enum ai_request_type {
  TUTOR
  QUESTION_GEN
  SUMMARIZE [note: '대화 요약 생성. 사용자 일일 한도 집계에서 제외']
}
Enum ai_request_status {
  RESERVED
  SUCCEEDED
  FAILED
  RELEASED
}
Enum model_tier {
  BASIC
  ADVANCED
}

// =====================================================================
// 1. 계정·인증  (API: /auth/*, /users/me, /users/me/notification-settings)
// =====================================================================
Table users {
  user_id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [unique, note: 'null 허용(소셜 전용 계정)']
  email_verified_at timestamptz
  password_hash varchar(255) [note: 'null 허용(소셜 전용 계정). 응답 노출 금지']
  password_changed_at timestamptz
  nickname varchar(30) [not null]
  nickname_updated_at timestamptz
  role user_role [not null, default: 'USER']
  plan user_plan [not null, default: 'FREE', note: 'AI Tutor 일일 한도 기준 (/tutor/usage)']
  account_status account_status [not null, default: 'ACTIVE']
  status_reason varchar(255)
  failed_login_count integer [not null, default: 0]
  locked_until timestamptz
  onboarding_completed_at timestamptz [note: 'v2 initial_setup_completed_at. null = 최초 직업 선택 필요 → API onboardingCompleted']
  last_login_at timestamptz
  last_login_method users_last_login_method
  withdrawn_at timestamptz [note: 'rev.4 탈퇴 시각. 탈퇴 시 email·password_hash는 null, nickname은 익명값으로 바꾸고 학습·보상 기록은 유지']
  withdrawal_reason varchar(255) [note: 'rev.4 탈퇴 사유 (선택 입력)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `(account_status = 'WITHDRAWN') = (withdrawn_at IS NOT NULL)` [name: 'chk_users_withdrawn']
  }
}

Table terms {
  terms_id uuid [pk, default: `gen_random_uuid()`, note: 'rev.4 약관 ID → API termsId']
  terms_type terms_type [not null]
  version integer [not null, default: 1]
  title varchar(100) [not null]
  content text [not null, note: '동의 당시 문구를 그대로 보존 (기존 행 수정 금지)']
  is_required boolean [not null, note: '필수 동의 여부']
  effective_at timestamptz [not null, note: '시행 시각. 같은 종류 중 시행된 최신 version이 현재 약관']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (terms_type, version) [unique]
  }
  Note: 'rev.4 추가. 약관·개인정보 동의 항목 마스터. 내용이 바뀌면 version을 올려 새 행 추가'
}

Table user_terms_agreements {
  agreement_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.user_id]
  terms_id uuid [not null, ref: > terms.terms_id]
  agreed boolean [not null, note: '동의 여부. 선택 항목은 거부(false)도 기록']
  agreed_at timestamptz [not null, default: `now()`, note: '응답 시각 (동의 또는 거부)']
  withdrawn_at timestamptz [note: '선택 동의 철회 시각. 다시 동의하면 null로 되돌리고 agreed_at 갱신']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, terms_id) [unique, note: '사용자·약관 버전별 1행']
  }
  Note: 'rev.4 추가. 회원가입·약관 개정 시 동의 기록. 탈퇴 후에도 동의 이력은 보존'
}

Table social_accounts {
  social_account_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.user_id]
  provider social_provider [not null]
  provider_user_id varchar(255) [not null]
  provider_email varchar(255)
  provider_nickname varchar(100)
  connected_at timestamptz [not null, default: `now()`]
  last_used_at timestamptz
  disconnected_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (provider, provider_user_id) [unique]
  }
}

Table account_tokens {
  token_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.user_id]
  token_type token_type [not null]
  token_hash varchar(255) [not null, unique, note: 'password_reset = API resetToken의 해시']
  target_email varchar(255) [not null]
  send_count integer [not null, default: 1]
  last_sent_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
}

Table user_devices {
  device_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.user_id]
  device_uuid varchar(100) [not null, note: '앱 설치 단위 식별자']
  platform device_platform [not null]
  os_version varchar(30)
  app_version varchar(30)
  device_model varchar(100)
  push_token varchar(512) [unique]
  push_token_updated_at timestamptz
  notification_permission boolean [not null, default: false]
  permission_checked_at timestamptz
  is_active boolean [not null, default: true]
  last_seen_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, device_uuid) [unique]
  }
}

Table user_sessions {
  session_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.user_id]
  device_id uuid [ref: > user_devices.device_id]
  refresh_token_hash varchar(255) [not null, unique, note: 'Cookie refreshToken의 해시. /auth/refresh에서 회전']
  login_method user_sessions_login_method [not null]
  issued_at timestamptz [not null, default: `now()`]
  last_refreshed_at timestamptz
  expires_at timestamptz [not null]
  revoked_at timestamptz
  revoke_reason session_revoke_reason
  created_at timestamptz [not null, default: `now()`]
}

Table user_settings {
  user_id uuid [pk, ref: - users.user_id]
  daily_goal_count smallint [note: '기본값 협의 전, null 허용']
  reminder_enabled boolean [not null, default: false, note: 'v2 study_reminder_enabled → API reminderEnabled']
  reminder_time time [note: 'v2 study_reminder_time → API reminderTime']
  timezone varchar(50) [not null, default: 'Asia/Seoul', note: 'v3 추가. IANA 이름 → API timezone']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `daily_goal_count IS NULL OR daily_goal_count > 0` [name: 'chk_settings_daily_goal']
  }
}

// =====================================================================
// 2. 캐릭터·상점  (API: /users/me/character/class, /inventory, /shop/*)
// =====================================================================
Table character_classes {
  class_id uuid [pk, default: `gen_random_uuid()`, note: 'v2 jobs.job_id → API classId']
  class_code class_code [not null, unique]
  name varchar(30) [not null, note: '검사 / 마법사 / 궁수']
  description varchar(255)
  image_key varchar(255)
  preview_image_key varchar(255)
  battle_effect_key varchar(255)
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'v2 jobs. "class"는 프로그래밍 예약어라 테이블명은 character_classes'
}

Table costumes {
  item_id uuid [pk, default: `gen_random_uuid()`, note: 'API itemId (상점·인벤토리·구매). rev.2 costume_id → item_id']
  costume_code varchar(50) [not null, unique]
  name varchar(100) [not null]
  description varchar(255)
  flavor_text varchar(255)
  category costume_category [not null, note: 'rev.5 부위 (TOP 상의 / BOTTOM 하의) → API Query category. 직업과 무관']
  price_coin integer [note: 'is_on_sale = true 이면 필수, >= 0']
  image_key varchar(255)
  thumbnail_key varchar(255)
  is_default boolean [not null, default: false, note: '가입 시 기본 지급 (부위별 1개씩, 직업과 무관)']
  is_on_sale boolean [not null, default: false]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `price_coin IS NULL OR price_coin >= 0` [name: 'chk_costumes_price']
    `NOT is_on_sale OR price_coin IS NOT NULL` [name: 'chk_costumes_on_sale_price']
  }
  indexes {
    (item_id, category) [unique, note: 'rev.5 장착 테이블 복합 FK 대상 (부위 일치 검사)']
    (category, sort_order) [note: '상점 부위별 목록']
  }
  Note: 'rev.5 직업과 무관하게 부위(category)로 분류'
}

Table user_characters {
  user_id uuid [pk, ref: - users.user_id, note: 'rev.5 장착 정보는 user_equipped_costumes로 분리']
  class_id uuid [not null, ref: > character_classes.class_id]
  first_selected_at timestamptz [not null, default: `now()`]
  class_changed_at timestamptz [note: 'v2 job_changed_at']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_costumes {
  user_id uuid [not null, ref: > users.user_id]
  item_id uuid [not null, ref: > costumes.item_id, note: 'rev.2 costume_id → API itemId']
  acquire_type costume_acquire_type [not null]
  coin_ledger_id uuid [unique, ref: - coin_ledger.coin_ledger_id, note: '구매 시 차감 원장 = API 구매 ID']
  acquired_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, item_id) [pk]
  }
}

Table user_equipped_costumes {
  user_id uuid [not null, note: '사용자']
  category costume_category [not null, note: '장착 부위 (TOP / BOTTOM)']
  item_id uuid [not null, note: '장착한 코스튬 → API itemId']
  equipped_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, category) [pk, note: '부위당 1개. 다시 장착하면 이 행을 교체']
  }
  Note: 'rev.5 추가. 부위별 장착 상태. 보유한 코스튬만, 부위가 맞는 코스튬만 저장됨 (복합 FK 2개). 행이 없으면 해당 부위 미장착'
}

// =====================================================================
// 3. 학습 콘텐츠  (API: /topics/*, /stages/{stageId}, /bosses/{bossId}, /concepts/{conceptId})
// =====================================================================
Table topics {
  topic_id uuid [pk, default: `gen_random_uuid()`, note: 'v2 regions.region_id → API topicId']
  topic_code varchar(30) [not null, unique]
  topic_no smallint [not null, unique, note: '1~9, 화면의 STAGE n']
  title varchar(100) [not null]
  description varchar(255)
  map_row smallint
  map_column smallint
  icon_key varchar(255)
  status topics_status [not null, default: 'DRAFT']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  Note: 'v2 regions. 경제 지식 트리의 주제'
}

Table topic_prerequisites {
  topic_id uuid [not null, ref: > topics.topic_id]
  prerequisite_topic_id uuid [not null, ref: > topics.topic_id]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (topic_id, prerequisite_topic_id) [pk]
  }
  checks {
    `topic_id <> prerequisite_topic_id` [name: 'chk_topic_prereq_not_self']
  }
  Note: 'v2 region_prerequisites. 1→2→3, 3→4·5, 5→6, 1→7→8→9. 선수 주제 BOSS 통과 시 해금'
}

Table stages {
  stage_id uuid [pk, default: `gen_random_uuid()`, note: 'v2 steps.step_id → API stageId. stage_type = BOSS 이면 API bossId']
  topic_id uuid [not null, ref: > topics.topic_id]
  stage_code varchar(20) [not null, unique, note: '1-1 / 1-2 / 1-BOSS']
  stage_no smallint [not null, note: '주제 내 순차 해금 순서, BOSS는 마지막']
  stage_type stage_type [not null]
  title varchar(100) [not null]
  description varchar(255)
  estimated_min_minutes smallint
  estimated_max_minutes smallint
  max_question_count smallint [not null, note: 'NORMAL 3 / BOSS 5']
  required_correct_count smallint [not null, note: 'NORMAL 2 / BOSS 4']
  initial_monster_hp smallint [not null, note: 'NORMAL 2 / BOSS 4']
  monster_name varchar(50)
  monster_image_key varchar(255)
  reward_total_exp integer [note: '미확정, null 허용']
  reward_economy_exp integer [note: '미확정, null 허용']
  reward_coin integer [note: '미확정, null 허용']
  status stages_status [not null, default: 'DRAFT']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (topic_id, stage_no) [unique]
  }
  checks {
    `required_correct_count <= max_question_count AND initial_monster_hp = required_correct_count` [name: 'chk_stages_counts']
    `estimated_min_minutes IS NULL OR estimated_max_minutes IS NULL OR estimated_min_minutes <= estimated_max_minutes` [name: 'chk_stages_minutes']
  }
  Note: 'v2 steps. 일반 Stage와 Boss를 한 테이블로 관리 (Boss = stage_type BOSS)'
}

Table concepts {
  concept_id uuid [pk, default: `gen_random_uuid()`]
  concept_code varchar(30) [not null, note: '버전 무관 식별자, ai.document_concepts와 공유']
  topic_id uuid [not null, ref: > topics.topic_id, note: 'v2 region_id']
  version integer [not null, default: 1]
  supersedes_concept_id uuid [ref: > concepts.concept_id]
  title varchar(100) [not null]
  short_definition varchar(255)
  summary varchar(255)
  estimated_minutes smallint
  source_document_ids text[] [note: '논리 참조: ai.knowledge_documents.document_id']
  status concept_status [not null, default: 'DRAFT']
  reviewed_by uuid [ref: > users.user_id]
  reviewed_at timestamptz
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (concept_code, version) [unique]
  }
}

Table concept_prerequisites {
  concept_code varchar(30) [not null, note: '논리 참조: concepts.concept_code']
  prerequisite_concept_code varchar(30) [not null, note: '논리 참조: concepts.concept_code']
  display_order smallint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (concept_code, prerequisite_concept_code) [pk]
  }
  checks {
    `concept_code <> prerequisite_concept_code` [name: 'chk_concept_prereq_not_self']
  }
  Note: 'v3 추가. GET /concepts/{conceptId}의 "선수 개념". 개념이 버전으로 바뀌어도 유지되도록 concept_code 기준'
}

Table concept_sections {
  section_id uuid [pk, default: `gen_random_uuid()`]
  concept_id uuid [not null, ref: > concepts.concept_id]
  page_no smallint [not null]
  sort_order smallint [not null]
  section_type section_type [not null]
  title varchar(100)
  body text [not null]
  card_tone card_tone [not null, default: 'DEFAULT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (concept_id, page_no, sort_order) [unique]
  }
}

Table stage_concepts {
  stage_id uuid [not null, ref: > stages.stage_id]
  concept_id uuid [not null, ref: > concepts.concept_id]
  display_order smallint [not null, default: 0]
  is_primary boolean [not null, default: true]
  indexes {
    (stage_id, concept_id) [pk]
  }
  Note: 'v2 step_concepts. NORMAL Stage는 1행만 허용(앱 검증), BOSS는 여러 개념'
}

Table questions {
  question_id uuid [pk, default: `gen_random_uuid()`]
  question_code varchar(30) [not null, note: '버전 무관 식별자']
  version integer [not null, default: 1]
  supersedes_question_id uuid [ref: > questions.question_id]
  concept_id uuid [not null, ref: > concepts.concept_id, note: '1문항 1개념']
  question_type question_type [not null, default: 'MULTIPLE_CHOICE']
  question_text text [not null]
  explanation text [not null, note: '정답 해설']
  key_point varchar(255) [note: '다시 기억해요']
  difficulty difficulty
  generated_by generated_by [not null]
  generation_request_id uuid [ref: > ai_requests.request_id]
  source_document_ids text[] [note: '논리 참조: ai.knowledge_documents.document_id']
  status question_status [not null, default: 'GENERATED']
  review_comment text
  reviewed_by uuid [ref: > users.user_id]
  reviewed_at timestamptz
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (question_code, version) [unique]
    (concept_id) [note: 'rev.4 개념별 문항·통계 조회']
  }
}

Table question_choices {
  choice_id uuid [pk, default: `gen_random_uuid()`, note: 'API choiceId']
  question_id uuid [not null, ref: > questions.question_id]
  base_order smallint [not null, note: '1~4']
  choice_text varchar(255) [not null]
  is_correct boolean [not null, default: false, note: '제출 전 응답 노출 금지']
  feedback_text varchar(255) [note: '오답 선택 시 피드백']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (question_id, base_order) [unique]
    (question_id, choice_id) [unique, note: 'rev.3 답안의 복합 FK 대상']
  }
  checks {
    `base_order BETWEEN 1 AND 4` [name: 'chk_choices_base_order']
  }
  Note: '문항당 4행, 정답 1개(앱 검증)'
}

Table stage_questions {
  stage_id uuid [not null, ref: > stages.stage_id]
  question_id uuid [not null, ref: > questions.question_id]
  question_order smallint [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (stage_id, question_order) [pk]
    (stage_id, question_id) [unique]
  }
  Note: 'v2 step_questions'
}

// =====================================================================
// 4. 진행도·퀴즈  (API: /learning/progress/*, /stages|bosses/{id}/attempts, /attempts/*, /stages/{id}/relearn)
// =====================================================================
Table user_stage_progress {
  user_id uuid [not null, ref: > users.user_id]
  stage_id uuid [not null, ref: > stages.stage_id]
  progress_status progress_status [not null, default: 'NOT_STARTED', note: '잠금은 계산, PASSED는 되돌리지 않음. 응시 결과 저장과 같은 트랜잭션에서 갱신']
  started_at timestamptz
  content_position smallint [note: 'rev.2 last_concept_id + last_page_no 통합 → API contentPosition (Stage 학습 콘텐츠의 페이지 번호, 1부터)']
  content_position_updated_at timestamptz [note: 'v3 추가. 학습 위치 저장 시각 (PUT /learning/progress 응답의 수정 시간)']
  read_started_at timestamptz
  read_completed_at timestamptz
  first_passed_at timestamptz
  first_pass_attempt_id uuid [ref: > learning_attempts.attempt_id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, stage_id) [pk]
  }
  checks {
    `content_position IS NULL OR content_position >= 1` [name: 'chk_progress_content_position']
  }
  Note: 'v2 user_step_progress'
}

Table learning_attempts {
  attempt_id uuid [pk, default: `gen_random_uuid()`, note: 'API attemptId. 재학습 세션 ID도 이 값']
  user_id uuid [not null, ref: > users.user_id]
  stage_id uuid [not null, ref: > stages.stage_id, note: 'v2 step_id. 일반·Boss 공통']
  attempt_no integer [not null]
  attempt_type attempt_type [not null, default: 'PLAY', note: 'PLAY = 응시, RELEARN = 완료 Stage 재학습 (보상 없음)']
  mode attempt_mode [not null, default: 'START', note: 'rev.2 is_retry → API Body mode (START = 처음 시작, RETRY = 실패 후 재도전)']
  status attempt_status [not null, default: 'IN_PROGRESS']
  end_reason attempt_end_reason
  max_question_count smallint [not null, note: '응시 시점 스냅샷']
  required_correct_count smallint [not null, note: '응시 시점 스냅샷']
  initial_hp smallint [not null, note: '응시 시점 스냅샷']
  final_hp smallint
  submitted_count smallint [not null, default: 0]
  correct_count smallint [not null, default: 0]
  is_first_pass boolean [not null, default: false]
  reward_granted boolean [not null, default: false]
  started_at timestamptz [not null, default: `now()`]
  ended_at timestamptz
  result_saved_at timestamptz
  idempotency_key varchar(100) [unique, note: '서버 내부용 중복 방지 키 (API 필드 없음, 응답 노출 안 함)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, stage_id, attempt_no) [unique]
    (user_id, started_at)
  }
  checks {
    `correct_count <= submitted_count AND submitted_count <= max_question_count` [name: 'chk_attempts_counts']
  }
  Note: 'rev.3 사용자·Stage별 IN_PROGRESS 응시 1개 (부분 유니크 인덱스, schema.sql 끝)'
}

Table question_submissions {
  submission_id uuid [pk, note: 'API Body submissionId. 앱이 만든 UUID를 PK로 저장 → 같은 값 재제출은 PK 중복으로 거부']
  attempt_id uuid [not null, ref: > learning_attempts.attempt_id]
  question_id uuid [not null, ref: > questions.question_id]
  sequence_no smallint [not null]
  displayed_choice_order uuid[] [not null]
  choice_id uuid [not null, note: 'rev.2 selected_choice_id → API Body choiceId. rev.3 (question_id, choice_id) → question_choices 복합 FK']
  selected_position smallint [not null, note: '화면상 1~4']
  is_correct boolean [not null]
  hp_before smallint [not null]
  hp_after smallint [not null]
  response_time_ms integer
  submitted_at timestamptz [not null, default: `now()`]
  indexes {
    (attempt_id, question_id) [unique]
    (attempt_id, sequence_no) [unique]
    (question_id) [note: 'rev.4 문항·개념별 정답률']
  }
  checks {
    `selected_position BETWEEN 1 AND 4` [name: 'chk_submissions_position']
  }
}

// =====================================================================
// 5. 보상·성장  (API: /users/me/reward-ledger, /growth/me)
// =====================================================================
Table user_growth {
  user_id uuid [pk, ref: - users.user_id]
  total_exp integer [not null, default: 0]
  total_level integer [not null, default: 1]
  economy_exp integer [not null, default: 0]
  economy_level integer [not null, default: 1]
  last_level_up_at timestamptz
  updated_at timestamptz [not null, default: `now()`]
  Note: 'exp_ledger와 같은 트랜잭션에서만 갱신'
}

Table user_wallets {
  user_id uuid [pk, ref: - users.user_id]
  coin_balance integer [not null, default: 0]
  version integer [not null, default: 0, note: '동시 구매 방지(낙관적 잠금)']
  updated_at timestamptz [not null, default: `now()`]
  checks {
    `coin_balance >= 0` [name: 'chk_wallets_balance']
  }
  Note: 'coin_ledger와 같은 트랜잭션에서만 갱신'
}

Table exp_ledger {
  exp_ledger_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.user_id]
  source_type exp_source_type [not null]
  source_stage_id uuid [not null, ref: > stages.stage_id, note: 'v2 source_step_id']
  attempt_id uuid [ref: > learning_attempts.attempt_id]
  total_exp_amount integer [not null]
  economy_exp_amount integer [not null]
  total_exp_after integer [not null]
  economy_exp_after integer [not null]
  total_level_after integer [not null]
  economy_level_after integer [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, source_type, source_stage_id) [unique, note: '최초 통과 보상 1회']
  }
}

Table coin_ledger {
  coin_ledger_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.user_id]
  transaction_type coin_transaction_type [not null]
  reason coin_reason [not null]
  amount integer [not null, note: '+ 지급 / - 차감']
  balance_before integer [not null]
  balance_after integer [not null]
  ref_type coin_ref_type [not null]
  ref_id uuid [not null, note: '논리 참조: STAGE → stages.stage_id / COSTUME → costumes.item_id']
  attempt_id uuid [ref: > learning_attempts.attempt_id]
  request_id varchar(100) [unique, note: 'rev.2 idempotency_key → 구매 API Body requestId (중복 구매 방지). ai_requests와 무관']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, reason, ref_id) [unique]
  }
  checks {
    `balance_after >= 0 AND balance_after = balance_before + amount` [name: 'chk_coin_ledger_balance']
  }
}

Table level_thresholds {
  scope level_scope [not null]
  level integer [not null]
  required_exp integer [not null, note: '누적 EXP 기준']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (scope, level) [pk]
  }
}

// =====================================================================
// 6. 오답·복습  (API: /reviews/*, /questions/{id}/bookmark, /review-attempts/*)
// =====================================================================
Table review_items {
  review_item_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.user_id]
  question_code varchar(30) [not null, note: '논리 참조: questions.question_code']
  latest_question_id uuid [not null, ref: > questions.question_id]
  concept_code varchar(30) [not null, note: '논리 참조: concepts.concept_code']
  source_stage_id uuid [ref: > stages.stage_id, note: 'v2 source_step_id']
  first_reason review_first_reason [not null, note: 'WRONG = 오답으로 등록 / BOOKMARK = 북마크로 등록']
  wrong_count integer [not null, default: 0, note: '제출과 같은 트랜잭션에서 갱신. 0보다 크면 오답 목록']
  last_answer_result answer_result
  last_answered_at timestamptz
  is_bookmarked boolean [not null, default: false, note: 'v2 is_confusing. true면 북마크 목록']
  bookmarked_at timestamptz [note: 'v2 flagged_at']
  unbookmarked_at timestamptz [note: 'v2 unflagged_at. 해제해도 오답 이력은 유지']
  first_registered_at timestamptz [not null, default: `now()`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, question_code) [unique, note: '오답·북마크 통합: 문제당 1행 (중복 표시 없음)']
    (user_id, concept_code)
    (user_id, is_bookmarked) [note: 'rev.4 북마크 목록']
  }
}

Table review_missions {
  mission_id uuid [pk, default: `gen_random_uuid()`, note: 'v2 concept_auto_reviews.auto_review_id → API missionId']
  user_id uuid [not null, ref: > users.user_id]
  concept_code varchar(30) [not null, note: '논리 참조: concepts.concept_code']
  first_registered_at timestamptz [not null]
  due_date date [not null, note: '최초 등록 + 3일(Asia/Seoul)']
  status review_mission_status [not null, default: 'SCHEDULED']
  target_question_count smallint
  notified_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, concept_code) [unique, note: '사용자·개념별 1회']
    (status, due_date)
  }
  Note: 'v2 concept_auto_reviews. 잔당 소탕 임무'
}

Table review_attempts {
  review_attempt_id uuid [pk, default: `gen_random_uuid()`, note: 'v2 review_sessions.review_session_id → API reviewAttemptId']
  user_id uuid [not null, ref: > users.user_id]
  mission_id uuid [ref: > review_missions.mission_id, note: 'review_type = AUTO 일 때만']
  review_type review_attempt_type [not null, note: 'v2 session_type']
  entry_point review_entry_point [not null]
  concept_code varchar(30) [note: '논리 참조: concepts.concept_code']
  status review_attempt_status [not null, default: 'IN_PROGRESS']
  question_count smallint [not null, note: '시작 시점 고정']
  submitted_count smallint [not null, default: 0]
  correct_count smallint [not null, default: 0]
  started_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, started_at)
  }
  checks {
    `correct_count <= submitted_count AND submitted_count <= question_count` [name: 'chk_review_attempts_counts']
  }
  Note: 'v2 review_sessions. 전투(HP) 없음. 원본 전투 결과를 바꾸지 않음'
}

Table review_submissions {
  submission_id uuid [pk, default: `gen_random_uuid()`, note: 'API Body submissionId. 복습 시작 시 서버가 문항별로 미리 만들어 내려주고, 제출 때 그대로 받음']
  review_attempt_id uuid [not null, ref: > review_attempts.review_attempt_id]
  review_item_id uuid [not null, ref: > review_items.review_item_id]
  question_id uuid [not null, ref: > questions.question_id, note: '실제 출제된 문항 버전']
  sequence_no smallint [not null]
  displayed_choice_order uuid[] [not null]
  choice_id uuid [note: 'rev.2 selected_choice_id → API Body choiceId. 미제출 시 null. rev.3 (question_id, choice_id) → question_choices 복합 FK']
  is_correct boolean
  bookmark_checked boolean [not null, default: false, note: 'v2 confusing_checked. 제출 시점 북마크 상태']
  response_time_ms integer
  submitted_at timestamptz
  indexes {
    (review_attempt_id, review_item_id) [unique]
    (review_attempt_id, sequence_no) [unique]
  }
}

// =====================================================================
// 7. 학습 일정  (API: /study-plans, /calendar)
// =====================================================================
Table study_plans {
  plan_id uuid [pk, default: `gen_random_uuid()`, note: 'v2 learning_schedules.schedule_id → API planId']
  user_id uuid [not null, ref: > users.user_id]
  scheduled_date date [not null, note: 'v2 target_date → API scheduledDate']
  stage_id uuid [ref: > stages.stage_id, note: 'v3 null 허용 (API stageId?)']
  concept_id uuid [ref: > concepts.concept_id, note: 'v3 추가 (API conceptId?)']
  plan_type plan_type [not null, default: 'NEW_LEARNING', note: 'v2 schedule_type']
  title varchar(30) [not null, note: 'v2 goal_memo → API title (필수, 30자 이내)']
  status plan_status [not null, default: 'PLANNED']
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: '소프트 삭제. 실제 학습 기록(attempts)은 별도 보존']
  indexes {
    (user_id, scheduled_date)
  }
  checks {
    `char_length(title) BETWEEN 1 AND 30` [name: 'chk_study_plans_title']
  }
  Note: 'v2 learning_schedules'
}

// =====================================================================
// 8. AI Tutor — 멀티턴 RAG  (API: /tutor/*, 내부 POST /internal/v1/tutor/answer)
//   흐름: Node가 history(요약 + 최근 N턴)를 모아 FastAPI에 보냄 → FastAPI는 상태 없음
//        → 응답의 답변·근거·재작성 쿼리를 Node가 저장
// =====================================================================
Table ai_conversations {
  conversation_id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.user_id, note: '대화 소유자 확인 기준']
  entry_point ai_entry_point [note: 'v3 null 허용 (대화 생성 API에 없음)']
  context_topic_id uuid [ref: > topics.topic_id, note: 'v2 context_region_id']
  context_stage_id uuid [ref: > stages.stage_id, note: 'v2 context_step_id. 대화 생성 시 stageId']
  context_concept_id uuid [ref: > concepts.concept_id, note: '대화 생성 시 conceptId']
  context_question_id uuid [ref: > questions.question_id]
  context_attempt_id uuid [ref: > learning_attempts.attempt_id]
  title varchar(100)
  status conversation_status [not null, default: 'ACTIVE']
  summary text [note: 'v3 추가. 오래된 턴의 요약 (대화가 길어질 때만 사용)']
  summary_until_seq integer [note: 'v3 추가. summary가 반영한 마지막 sequence_no']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: '목록 정렬 기준. 메시지 저장 시 함께 갱신']
  indexes {
    (user_id, updated_at)
  }
}

Table ai_messages {
  message_id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null, ref: > ai_conversations.conversation_id]
  parent_message_id uuid [ref: > ai_messages.message_id, note: '답변 → 질문']
  sequence_no integer [not null, note: '대화 내 순서. 메시지 조회 cursor 기준']
  role message_role [not null]
  input_type message_input_type
  client_message_id varchar(100) [note: 'v3 추가. user 메시지의 API clientMessageId (재전송 중복 방지)']
  context_stage_id uuid [ref: > stages.stage_id, note: 'v3 추가. 이번 질문의 stageId']
  context_concept_id uuid [ref: > concepts.concept_id, note: 'v3 추가. 이번 질문의 conceptId']
  content text [not null]
  rewritten_query text [note: 'v3 추가. user 메시지: 이전 대화를 반영해 다시 쓴 검색 쿼리 (FastAPI 응답)']
  history_from_seq integer [note: 'v3 추가. assistant 메시지: 프롬프트에 원문으로 넣은 첫 sequence_no']
  token_count integer [note: 'v3 추가. 히스토리 자를 때 사용']
  status message_status [not null, default: 'PENDING']
  grounding_status grounding_status [note: 'API 검색 상태']
  error_code varchar(50)
  request_id uuid [ref: > ai_requests.request_id]
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  indexes {
    (conversation_id, sequence_no) [unique]
    (conversation_id, client_message_id) [unique, note: 'NULL은 중복 허용 (assistant 메시지)']
  }
  Note: '부분 유니크 인덱스(대화방당 pending 답변 1개)는 schema.sql 끝에 있음'
}

Table ai_message_sources {
  message_source_id uuid [pk, default: `gen_random_uuid()`]
  message_id uuid [not null, ref: > ai_messages.message_id]
  document_id varchar(100) [not null, note: '논리 참조: ai.knowledge_documents.document_id']
  document_version integer [not null]
  chunk_id varchar(100) [note: 'v3 추가. 논리 참조: ai 스키마의 청크 ID']
  title_snapshot varchar(255)
  concept_code varchar(30) [note: '논리 참조: concepts.concept_code']
  rank smallint [not null]
  relevance_score numeric(5,4)
  created_at timestamptz [not null, default: `now()`]
  Note: 'API 응답의 검색 출처 / 인용 근거'
}

Table ai_requests {
  request_id uuid [pk, default: `gen_random_uuid()`, note: '내부 API Body requestId']
  user_id uuid [ref: > users.user_id]
  conversation_id uuid [ref: > ai_conversations.conversation_id]
  request_type ai_request_type [not null]
  status ai_request_status [not null, default: 'RESERVED']
  usage_date date [not null, note: 'reserved_at의 KST 날짜(생성 컬럼), 일일 한도 집계. 정의는 schema.sql']
  model_tier model_tier [not null]
  model_id varchar(100)
  embedding_model_id varchar(100)
  knowledge_scope jsonb [note: 'v3 추가. 내부 API knowledgeScope (검색 범위: concept_code 목록 등)']
  input_tokens integer [note: '쿼리 재작성 호출 포함 합계']
  output_tokens integer
  latency_ms integer
  cache_hit boolean
  retrieval_strategy varchar(50)
  estimated_cost numeric(12,6)
  currency varchar(3)
  retry_count smallint [not null, default: 0]
  error_code varchar(50)
  idempotency_key varchar(100) [unique, note: '서버 내부용 중복 방지 키 (API 필드 없음, 응답 노출 안 함)']
  reserved_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  indexes {
    (user_id, usage_date, status)
  }
  Note: '턴 1회 = tutor 요청 1건. 사용량(/tutor/usage)은 request_type = TUTOR만 집계'
}

// =====================================================================
// 복합 FK (무결성, rev.3·rev.5)
// =====================================================================
// rev.5 보유한 코스튬만 장착 가능
Ref fk_equipped_owned: user_equipped_costumes.(user_id, item_id) > user_costumes.(user_id, item_id)
// rev.5 장착 부위와 코스튬 부위가 같아야 함 (상의 칸에 하의 금지)
Ref fk_equipped_category: user_equipped_costumes.(item_id, category) > costumes.(item_id, category)
// 답안의 선택지는 그 문항의 선택지여야 함
Ref fk_question_submissions_choice: question_submissions.(question_id, choice_id) > question_choices.(question_id, choice_id)
Ref fk_review_submissions_choice: review_submissions.(question_id, choice_id) > question_choices.(question_id, choice_id)

// =====================================================================
// ERD 그룹 (dbdiagram.io에서 색으로 구분)
// =====================================================================
