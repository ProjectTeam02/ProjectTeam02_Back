{
  "name": "@leren/database",
  "version": "0.4.0",
  "private": true,
  "description": "Leren app 스키마 v3(rev.5) TypeORM 엔티티·마이그레이션·검증 스크립트",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p .",
    "migration:generate": "npm run build && typeorm migration:generate -d dist/migration-data-source.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/migration-data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/migration-data-source.js",
    "migration:show": "typeorm migration:show -d dist/migration-data-source.js",
    "migration:check": "typeorm migration:generate src/migrations/Drift -d dist/migration-data-source.js --check",
    "seed": "node dist/scripts/seed-minimal.js",
    "test:db": "node dist/scripts/smoke.js"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "pg": "8.11.3",
    "reflect-metadata": "0.2.1",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@types/node": "20.12.7",
    "typescript": "5.4.5"
  }
}
