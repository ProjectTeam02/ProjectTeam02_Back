{
  "name": "leren-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "workspaces": [
    "database"
  ],
  "scripts": {
    "predev": "npm run db:build",
    "dev": "node --watch src/server.js",
    "prestart": "npm run db:build",
    "start": "node src/server.js",
    "pretest": "npm run db:build",
    "test": "node --test --test-concurrency=1",
    "db:build": "npm run build -w @leren/database",
    "db:migrate": "npm run migration:run -w @leren/database",
    "db:migrate:show": "npm run migration:show -w @leren/database",
    "db:check": "npm run migration:check -w @leren/database",
    "db:seed": "npm run seed -w @leren/database",
    "db:test": "npm run test:db -w @leren/database",
    "test:stage-quiz:contract": "node --test test/integration/extended-api-postgres.test.js",
    "test:question-generation:pg": "npm run db:build && node scripts/test-question-generation-postgres.js"
  },
  "dependencies": {
    "@leren/database": "0.5.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
